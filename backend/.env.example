# ==============================================================================
# Personal Finance AI — Backend Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="Personal Finance AI API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection
# PostgreSQL (Production / Local Docker / Local Service):
# DATABASE_URL=postgresql://finance:finance_dev_pw@localhost:5432/finance_db
#
# SQLite (Local Dev / Offline / Testing):
DATABASE_URL=sqlite:///./finance_dev.db

# JWT Security
# Generate a strong 256-bit secret using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Gemini AI Integration
# Leave empty to run in degraded mode (totals computed deterministically; advice stubs provided)
GEMINI_API_KEY=

# CORS Configuration
# JSON list of allowed origins or comma-separated strings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5000","*"]
